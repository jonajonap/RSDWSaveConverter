<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RSDWSaveConverter.App.MainWindow"
        Title="RSDW Save Converter"
        Width="820"        Height="660"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101113"
        Foreground="#F0EEE8">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="28,24,28,20">
        <!-- Title Panel (Row 0) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="RSDW SAVE CONVERTER"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#F0EEE8"
                       LetterSpacing="0.5" />
            <TextBlock Text="Steam to Xbox Game Pass"
                       FontSize="11"
                       Foreground="#E5C95C"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Drop Panel (Row 1) -->
        <Border Grid.Row="1"
                Name="DropZone"
                Background="#191A1D"
                BorderBrush="#484439"
                BorderThickness="1"
                CornerRadius="3"
                Padding="22"
                Margin="0,0,0,16"
                DragDrop.AllowDrop="True">
            <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Name="FileNameText"
                           Text="No save selected"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#F0EEE8"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Name="FileDetailsText"
                           Text=""
                           FontSize="11"
                           Foreground="#ACAAB3"
                           Margin="0,4,0,0" />

                <Button Grid.Row="0" Grid.Column="1"
                        Name="ChooseSaveButton"
                        Content="Choose Save File"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#191A1D"
                        BorderBrush="#484439"
                        Foreground="#F0EEE8"
                        Cursor="Hand"
                        Height="36"
                        Margin="12,0,0,8" />
                <Button Grid.Row="1" Grid.Column="1"
                        Name="ExportPayloadButton"
                        Content="Export .xav"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#191A1D"
                        BorderBrush="#484439"
                        Foreground="#F0EEE8"
                        Cursor="Hand"
                        Height="34"
                        Margin="12,0,0,0"
                        IsEnabled="False" />
            </Grid>
        </Border>

        <!-- Dedicated Server Conversion Options (Row 2) -->
        <Border Grid.Row="2"
                Name="ServerOptionsPanel"
                Background="#191A1D"
                BorderBrush="#484439"
                BorderThickness="1"
                CornerRadius="3"
                Padding="16,12"
                Margin="0,0,0,16"
                IsVisible="False">
            <StackPanel Spacing="3">
                <CheckBox Name="ConvertServerSaveCheckBox"
                          Content="Convert dedicated server save to local (remove password, set Solo mode)"
                          Foreground="#F0EEE8"
                          FontWeight="SemiBold"
                          FontSize="12"
                          IsChecked="True" />
                <TextBlock Name="ServerOptionsDetailsText"
                           Text="Removes the server password, switches session to Solo offline, and repairs download truncation."
                           FontSize="11"
                           Foreground="#ACAAB3"
                           Margin="28,-2,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Section Header (Row 3) -->
        <TextBlock Grid.Row="3"
                   Text="GAME PASS DESTINATION"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#E5C95C"
                   Margin="0,0,0,8"
                   LetterSpacing="0.5" />

        <!-- Destination Setup (Row 4) -->
        <StackPanel Grid.Row="4" Spacing="6">
            <!-- Profile Row Header -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Game Pass profile"
                           FontSize="11"
                           Foreground="#F0EEE8"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Name="ProfileStatusText"
                           Text="Searching for Game Pass saves..."
                           FontSize="11"
                           Foreground="#ACAAB3"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Profile Controls -->
            <Grid ColumnDefinitions="*,145,105">
                <ComboBox Grid.Column="0"
                          Name="ProfilePicker"
                          HorizontalAlignment="Stretch"
                          Background="#191A1D"
                          Foreground="#F0EEE8"
                          BorderBrush="#484439"
                          Height="36" />
                <Button Grid.Column="1"
                        Name="ChooseProfileButton"
                        Content="Choose Profile"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#191A1D"
                        BorderBrush="#484439"
                        Foreground="#F0EEE8"
                        Cursor="Hand"
                        Height="36"
                        Margin="8,0,0,0" />
                <Button Grid.Column="2"
                        Name="RefreshProfilesButton"
                        Content="Refresh"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#191A1D"
                        BorderBrush="#484439"
                        Foreground="#F0EEE8"
                        Cursor="Hand"
                        Height="36"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Name="DestinationLabel"
                       Text="Choose a save to list compatible slots"
                       FontSize="11"
                       Foreground="#F0EEE8"
                       Margin="0,12,0,0" />

            <ComboBox Name="DestinationPicker"
                      HorizontalAlignment="Stretch"
                      Background="#191A1D"
                      Foreground="#F0EEE8"
                      BorderBrush="#484439"
                      Height="36" />
        </StackPanel>

        <!-- Import Button (Row 5) -->
        <Button Grid.Row="5"
                Name="ImportButton"
                Content="Import Save"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#E5C95C"
                Foreground="#191710"
                FontWeight="Bold"
                FontSize="13"
                Height="46"
                Cursor="Hand"
                Margin="0,14,0,12"
                IsEnabled="False" />

        <!-- Status & Progress Row (Row 6) -->
        <Grid Grid.Row="6" ColumnDefinitions="*,150">
            <TextBlock Grid.Column="0"
                       Name="StatusText"
                       Text="Ready"
                       FontSize="11"
                       Foreground="#ACAAB3"
                       VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1"
                         Name="ProgressBar"
                         IsIndeterminate="True"
                         IsVisible="False"
                         Height="12"
                         VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
